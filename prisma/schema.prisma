// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  role      String   @default("admin")
  createdAt DateTime @default(now())
}

model EnxovalItem {
  id           String        @id @default(uuid())
  nome         String
  descricao    String?
  valor        Float
  prioridade   String        // Alta, Média, Baixa
  status       String        @default("Disponível") // Disponível, Reservado, Comprado
  reservadoPor String?
  reservas     Reservation[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([status])
}

model PurchasedItem {
  id         String   @id @default(uuid())
  nome       String
  categoria  String
  valor      Float
  dataCompra DateTime @default(now())
  createdAt  DateTime @default(now())
}

model Reservation {
  id          String      @id @default(uuid())
  enxovalId   String
  enxovalItem EnxovalItem @relation(fields: [enxovalId], references: [id])
  nome        String
  whatsapp    String
  mensagem    String?
  dataReserva DateTime    @default(now())
  createdAt   DateTime    @default(now())

  @@index([enxovalId])
}

model Settings {
  id                String  @id @default("global")
  pixKey            String  @default("")
  pixName           String  @default("")
  coupleNames       String  @default("Tais & Yran")
  weddingDate       String  @default("2027-02-02")
  whatsappNumber    String  @default("")
  whaticketApiUrl   String  @default("https://api.whaticketup.com.br/api/messages/send")
  whaticketToken    String  @default("")
  whaticketUserId   String  @default("")
  whaticketQueueId  String  @default("")
  whaticketTemplate String  @default("🎁 Nova reserva no site ({couple})\n\nPresente: {item}\nConvidado(a): {nome}\nWhatsApp: {whatsapp}\nRecado: {mensagem}\n\nOpções de presente: podem comprar o item por conta própria e entregar aos noivos, ou enviar o valor via PIX:\nChave PIX: {pixKey}\nTitular: {pixName}")
  guestReplyTemplate String @default("Oi, {nome}! Obrigado pelo carinho com {couple}. 💛\n\nRecebemos sua reserva do presente: \"{item}\".\n\nVocê pode escolher a melhor forma de presentear:\n1) Comprar o item por conta própria e entregar aos noivos.\n2) Enviar o valor via PIX.\n\nSe preferir PIX, mando a chave na próxima mensagem para facilitar copiar e colar.")
  guestPixTemplate   String @default("{pixKey}")
  whaticketSign     Boolean @default(true)
  whaticketClose    Boolean @default(false)
  ceremonyTime      String  @default("16:00")
  ceremonyVenue     String  @default("")
  ceremonyAddress   String  @default("")
  receptionVenue    String  @default("")
  receptionAddress  String  @default("")
  invitationMessage String  @default("Com muito amor, queremos compartilhar esse momento especial com você. Sua presença tornará nosso dia ainda mais inesquecível.")
  rsvpDeadline      String  @default("")
  dressCode         String  @default("")
  coupleStory       String  @default("")
  inviteTheme       String  @default("classico")
  openingText       String  @default("Você recebeu um convite especial")
  romanticLine      String  @default("")
  coverPhotoUrl     String  @default("")
  galleryJson       String  @default("[]")
  scheduleJson      String  @default("[]")
  ceremonyNotes     String  @default("")
  receptionNotes    String  @default("")
  extraInfo         String  @default("")
  rsvpText          String  @default("Sua presença é o presente mais importante. Conte se poderemos comemorar juntos.")
  showStory         Boolean @default(true)
  showGallery       Boolean @default(true)
  showSchedule      Boolean @default(true)
  showDress         Boolean @default(true)
  showGifts         Boolean @default(true)
  inviteTemplate    String  @default("Olá, {nome}! ❤️\n\nPreparamos um convite muito especial para você.\n\nNós vamos nos casar e ficaremos muito felizes em compartilhar esse momento com você!\n\n📅 Data: {data}\n🕒 Horário: {horario}\n\nAbra seu convite especial:\n{link}\n\nEsperamos você! Com carinho, {casal}.")
  saveTheDateTemplate String @default("Olá, {nome}! Guarde esta data com carinho.\n\n📅 {data}, às {horario}\n\n{casal} vão se casar. O convite completo está aqui:\n{link}")
  reminderTemplate  String  @default("Olá, {nome}! Ainda não recebemos sua resposta para o casamento de {casal}.\n\n📅 {data} às {horario}\n\nAbra o convite e confirme sua presença:\n{link}")
  soonTemplate      String  @default("Olá, {nome}! O casamento de {casal} está chegando.\n\n📅 {data} às {horario}\n\nVeja os detalhes no seu convite:\n{link}")
}

model WeddingGuest {
  id            String                 @id @default(uuid())
  token         String                 @unique
  name          String
  whatsapp      String                 @unique
  groupName     String                 @default("amigos")
  seats         Int                    @default(1)
  notes         String                 @default("")
  optedOut      Boolean                @default(false)
  status        String                 @default("pending")
  lastError     String                 @default("")
  attemptCount  Int                    @default(0)
  lastRequestId String                 @default("")
  sentAt        DateTime?
  lastAttemptAt DateTime?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  rsvp          WeddingRsvp?
  attempts      WeddingInviteAttempt[]

  @@index([status])
  @@index([groupName])
}

model WeddingInviteAttempt {
  id        String       @id @default(uuid())
  guestId   String
  guest     WeddingGuest @relation(fields: [guestId], references: [id], onDelete: Cascade)
  campaign  String
  status    String
  requestId String       @default("")
  createdAt DateTime     @default(now())

  @@index([guestId, createdAt])
}

model WeddingRsvp {
  id        String   @id @default(uuid())
  name      String
  whatsapp  String   @unique
  guests    Int      @default(1)
  attending Boolean
  message   String?
  guestId   String?      @unique
  guest     WeddingGuest? @relation(fields: [guestId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
  @@index([attending])
}
