# Copie para .env e preencha. Não commite o .env.

APP_URL=https://taiseyran.com.br
PORT=3010

DB_DIALECT=postgres
DB_HOST=127.0.0.1
DB_PORT=5433
DB_USER=enxoval
DB_PASS=troque_esta_senha
DB_NAME=enxoval

# Obrigatório em produção, com pelo menos 32 caracteres.
JWT_SECRET=troque_por_openssl_rand_hex_32

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=troque_esta_senha

# lax serve o site e a API no mesmo domínio. Use none apenas no app Capacitor em outra origem.
COOKIE_SAMESITE=lax
